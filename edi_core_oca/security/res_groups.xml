<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_edi_advanced_settings_manager" model="res.groups">
        <field name="name">EDI Advanced Settings Manager</field>
        <field name="privilege_id" ref="base_edi.res_groups_privilege_edi" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
    <record id="group_edi_override_exchange_file_content" model="res.groups">
        <field name="name">EDI Override Exchange File Content</field>
        <field name="privilege_id" ref="base_edi.res_groups_privilege_edi" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
