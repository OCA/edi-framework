<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edi_exchange_type_view_form" model="ir.ui.view">
        <field name="model">edi.exchange.type</field>
        <field name="inherit_id" ref="edi_core_oca.edi_exchange_type_view_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="notification_config" string="Notifications">
                    <field
                        name="notification_rule_ids"
                        context="{'active_test': False}"
                    >
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                            <field name="notification_type" />
                            <field name="allowed_trigger_ids" column_invisible="1" />
                            <field
                                name="trigger_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                            />
                            <field
                                name="activity_type_id"
                                invisible="notification_type != 'activity'"
                                required="notification_type == 'activity'"
                            />
                            <field
                                name="group_ids"
                                widget="many2many_tags"
                                invisible="notification_type != 'activity'"
                            />
                            <field
                                name="user_ids"
                                widget="many2many_tags"
                                invisible="notification_type != 'activity'"
                            />
                            <field name="active" widget="boolean_toggle" />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
