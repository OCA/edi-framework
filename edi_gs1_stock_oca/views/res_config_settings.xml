<odoo>
    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field name="name">res.config.settings.form (in edi_gs1_stock)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="priority" eval="90" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="GS1" name="gs1_setting_container">
                    <setting
                        id="gs1_main_uom_setting"
                        string="GS1 main UoM"
                        company_dependent="1"
                        help="Determine the main UoM for GS1 stock file"
                    >
                        <field name="gs1_main_uom_id" />
                    </setting>
                    <setting
                        id="gs1_second_uom_setting"
                        string="GS1 second UoM"
                        company_dependent="1"
                        help="Determine the secondary UoM for GS1 stock file"
                    >
                        <field name="gs1_second_uom_id" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
