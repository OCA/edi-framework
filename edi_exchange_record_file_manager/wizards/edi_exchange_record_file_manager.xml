<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="edi_exchange_record_file_manager_view_form" model="ir.ui.view">
        <field name="name">edi.exchange.record.file.manager.form</field>
        <field name="model">edi.exchange.record.file.manager</field>
        <field name="arch" type="xml">
            <form string="Edit File">
                <sheet>
                    <!-- Add this ``div`` at the top to avoid being hidden if the ``file_content`` field is too long -->
                    <div
                        class="alert alert-info"
                        role="status"
                        invisible="state not in ('edit', 'replace')"
                    >
                        Clicking on "Proceed" will automatically update the Exchange Record's file.
                    </div>
                    <!-- State 1: setup -->
                    <div name="state_setup" invisible="state != 'setup'">
                        <group>
                            <field
                                name="mode"
                                widget="radio"
                                required="state == 'setup'"
                            />
                        </group>
                    </div>
                    <!-- State 2a: edit -->
                    <div name="state_edit" invisible="state != 'edit'">
                        <group>
                            <field name="ace_mode" required="state == 'edit'" />
                        </group>
                        <field
                            name="file_content"
                            nolabel="1"
                            widget="ace"
                            options="{'mode': 'javascript'}"
                            invisible="ace_mode != 'javascript'"
                        />
                        <field
                            name="file_content"
                            nolabel="1"
                            widget="ace"
                            options="{'mode': 'xml'}"
                            invisible="ace_mode != 'xml'"
                        />
                        <field
                            name="file_content"
                            nolabel="1"
                            widget="ace"
                            options="{'mode': 'qweb'}"
                            invisible="ace_mode != 'qweb'"
                        />
                        <field
                            name="file_content"
                            nolabel="1"
                            widget="ace"
                            options="{'mode': 'scss'}"
                            invisible="ace_mode != 'scss'"
                        />
                        <field
                            name="file_content"
                            nolabel="1"
                            widget="ace"
                            options="{'mode': 'python'}"
                            invisible="ace_mode != 'python'"
                        />
                        <!-- In case ``ace_mode`` is "txt", add an empty ``options`` attribute -->
                        <field
                            name="file_content"
                            nolabel="1"
                            widget="ace"
                            options="{}"
                            invisible="ace_mode != 'txt'"
                        />
                    </div>
                    <!-- State 2b: replace -->
                    <div name="state_replace" invisible="state != 'replace'">
                        <p>Here is the current file:</p>
                        <field
                            name="exchange_record_file"
                            filename="exchange_record_filename"
                            readonly="1"
                        />
                        <field name="exchange_record_filename" invisible="1" />
                        <hr />
                        <p>Please upload your new file:</p>
                        <field
                            name="new_file"
                            filename="new_filename"
                            required="state == 'replace'"
                        />
                        <field name="new_filename" invisible="1" />
                    </div>
                    <!-- State 3: done -->
                    <div name="state_done" invisible="state != 'done'">
                        <div class="alert alert-success" role="status">
                            <p>The file has been updated.</p>
                            <p invisible="not exchange_record_retryable">
                                Close this dialog and click on "Retry" to reschedule the exchange.
                            </p>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button
                        name="button_proceed"
                        type="object"
                        string="Proceed"
                        class="btn-primary"
                        invisible="button_proceed_invisible"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        invisible="button_cancel_invisible"
                    />
                    <button
                        string="Close"
                        class="btn-secondary"
                        special="cancel"
                        invisible="button_close_invisible"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
