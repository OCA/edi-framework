<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edi_exchange_record_view_form_inherit" model="ir.ui.view">
        <field name="model">edi.exchange.record</field>
        <field name="inherit_id" ref="edi_core_oca.edi_exchange_record_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_retry']" position="after">
                <button
                    name="button_open_file_manager"
                    type="object"
                    string="Manage File"
                    invisible="button_open_file_manager_invisible"
                />
            </xpath>
        </field>
    </record>
</odoo>
