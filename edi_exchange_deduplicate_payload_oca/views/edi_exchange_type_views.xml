<odoo>
    <record id="edi_exchange_type_view_form" model="ir.ui.view">
        <field name="name">edi.exchange.type.form.inherit.dedup.payload</field>
        <field name="model">edi.exchange.type</field>
        <field
            name="inherit_id"
            ref="edi_exchange_deduplicate_oca.edi_exchange_type_view_form_inherit"
        />
        <field name="arch" type="xml">
            <field name="deduplicate_on_exchange" position="after">
                <field
                    name="deduplicate_unchanged_payload"
                    invisible="direction != 'output'"
                />
            </field>
        </field>
    </record>
</odoo>
